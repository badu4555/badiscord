{
  "name": "badiscord",
  "productName": "BADISCORD",
  "version": "1.0.0",
  "description": "Aplicativo Desktop de Voz e Streaming até 2K",
  "main": "main.js",
  "scripts": {
    "start": "node server/server.js",
    "build:native-audio": "node scripts/build-native-audio.js",
    "desktop": "npm run build:native-audio && electron .",
    "server": "node server/server.js",
    "dev": "npm run build:native-audio && concurrently \"node server/server.js\" \"electron .\"",
    "build:exe": "npm run build:native-audio && electron-builder --win dir",
    "build:zip": "npm run build:native-audio && electron-builder --win zip"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.5",
    "dotenv": "^18.0.9",
    "express": "^4.21.0",
    "livekit-client": "^2.6.0",
    "livekit-server-sdk": "^2.9.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.badiscord.app",
    "productName": "BADISCORD",
    "extraResources": [
      {
        "from": "native/process-audio-capture.exe",
        "to": "process-audio-capture.exe"
      }
    ],
    "win": {
      "target": [
        "dir",
        "zip"
      ],
      "signAndEditExecutable": false
    }
  }
}
